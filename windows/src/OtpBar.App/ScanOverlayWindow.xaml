<Window x:Class="OtpBar.App.ScanOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描二维码" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="#26000000" Cursor="Cross"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <!-- Nothing but a dim wash over the live desktop: freezing a 4K-wide virtual screen
         would cost tens of megabytes and a full-size bitmap render every time. -->
    <Grid x:Name="Root" ClipToBounds="True">
        <Border x:Name="Selection" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                BorderBrush="#4DA3FF" BorderThickness="2" Background="#144DA3FF" />

        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,48,0,0"
                Background="#E6202124" CornerRadius="8" Padding="18,12">
            <TextBlock Foreground="White" FontSize="14" TextAlignment="Center">
                拖动鼠标框住二维码<LineBreak />
                <Run FontSize="12" Foreground="#A8ABB2">Esc 或右键取消</Run>
            </TextBlock>
        </Border>
    </Grid>
</Window>
