<Window x:Class="OtpBar.App.CodePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OtpBar.App"
        Title="OTPBar" Width="292" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="6">
        <StackPanel>
            <Grid Margin="9,6,9,8">
                <TextBlock Text="OTPBar" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="点击验证码复制" FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedBrush}" />
            </Grid>

            <TextBlock x:Name="EmptyNotice" Margin="14" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed" />

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" MaxHeight="470">
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CodeRow}">
                            <Border Style="{StaticResource Row}" Margin="0,1" Cursor="Hand"
                                    MouseLeftButtonUp="OnRowClicked" Tag="{Binding}">
                                <StackPanel Margin="10,8">
                                    <Grid>
                                        <TextBlock Text="{Binding Entry.Name}" FontSize="12" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
                                        <TextBlock Text="{Binding Entry.Account}" FontSize="11" MaxWidth="165"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </Grid>
                                    <Grid Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Code}" FontSize="22" FontWeight="Medium"
                                                   FontFamily="Consolas, Cascadia Mono, Courier New" />
                                        <TextBlock Text="{Binding Remaining}" FontSize="11" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Height="1" Margin="6,6" Background="{DynamicResource LineBrush}" />

            <Border x:Name="SettingsRow" Style="{StaticResource MenuRow}" Cursor="Hand"
                    MouseLeftButtonUp="OnSettingsClicked">
                <TextBlock Text="设置…" FontSize="13" Margin="9,6" />
            </Border>
        </StackPanel>
    </Border>
</Window>
