<Window x:Class="OtpBar.App.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份密码" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" />
        <PasswordBox x:Name="PasswordInput" Margin="0,14,0,0" Padding="8,6" FontSize="14"
                     Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                     CaretBrush="{DynamicResource TextBrush}" />
        <TextBlock Text="密码只用于解密这份备份，不会保存。" FontSize="11" Margin="0,8,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource Compact}" IsCancel="True" Click="OnCancel" />
            <Button Content="解密并导入" Style="{StaticResource CompactPrimary}" Margin="8,0,0,0"
                    IsDefault="True" Click="OnConfirm" />
        </StackPanel>
    </StackPanel>
</Window>
